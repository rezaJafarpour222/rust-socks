# SOCKS5 listener address.
SOCKS5_PORT=0.0.0.0:3000

# DNS cache settings.
CACHE_DURATION_SECS=86400
CACHE_ENTRY_LIMIT=10000

# TLS certificate files.
CERT_PATH=certs/cert.pem
KEY_PATH=certs/key.pem

# Optional SOCKS5 username/password authentication.
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Optional .env loading is handled by the application on startup.
